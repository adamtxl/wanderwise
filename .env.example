# Secret used to sign the Express session cookie (min 8 characters)
SERVER_SESSION_SECRET=**********

# Vite client env var for the Mapbox GL access token
VITE_MAPBOX_TOKEN=[MAPBOX_ACCESS_TOKEN]

# Postgres connection string for the server
DATABASE_URL='postgresql://[USERNAME]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require'

# Port the Express server listens on (optional, defaults to 8080)
PORT=8080

# Node environment; set to 'test' to use a fixed session secret in tests (optional)
NODE_ENV=development
